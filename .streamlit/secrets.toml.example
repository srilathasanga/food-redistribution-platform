# Copy this file to .streamlit/secrets.toml for local use, or paste the same
# content into Streamlit Community Cloud -> your app -> Settings -> Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).

# Database: the connection string from Neon (Dashboard -> Connect,
# choose the "Pooled connection" option).
DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# People who become admins automatically when they first sign in.
ADMIN_EMAILS = ["coordinator@example.org"]

# Times are shown and checked in this zone.
APP_TIMEZONE = "Asia/Kolkata"

# Google sign-in (see README, "Set up Google login").
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "PASTE-A-LONG-RANDOM-STRING-HERE"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "PASTE-GOOGLE-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
